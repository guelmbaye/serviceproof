# ─────────────────────────────────────────────────────────────
# ServiceProof AI — root environment (consumed by docker compose)
# ─────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

API_PORT=8000
AGENT_PORT=9000
WEB_PORT=3000

DB_DATABASE=serviceproof
DB_USERNAME=serviceproof
DB_PASSWORD=serviceproof
DB_PORT_EXPOSED=5432
REDIS_PORT_EXPOSED=6379

# Shared secret for the Laravel -> FastAPI internal channel.
AGENT_INTERNAL_TOKEN=dev-internal-token
AGENT_TIMEOUT=45

# Bearer tokens expire after this many minutes. Blank means never, which is
# fine for a demo and wrong for anything else.
SANCTUM_TOKEN_EXPIRATION=720

# The platform root account created by PlatformSeeder (root@serviceproof.ai).
# Change this before the machine is reachable by anyone but you.
SP_SUPER_ADMIN_PASSWORD=password

# ─── AI provider ──────────────────────────────────────────────
# heuristic | gemini | groq | ollama
# "heuristic" runs the agent with the deterministic planner only:
# no external AI call, identical orchestration semantics. Use it
# when you have no key yet, or as the demo-day safety net.
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ─── Nokia Network as Code (CAMARA access layer) ──────────────
# auto  = try live, fall back to the labelled demo adapter
# live  = live only (failures surface as UNAVAILABLE evidence)
# demo  = demo adapter only (every evidence item tagged DEMO_FALLBACK)
CAMARA_MODE=auto
NAC_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
NAC_RAPIDAPI_KEY=
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_TIMEOUT=8

# Capability paths, confirmed against the Nokia developer portal. Each API
# carries its own CAMARA version and they do not move in step, so these stay
# configurable rather than hardcoded.
# Roaming also exists on the older operation: /device-status/v0/roaming
NAC_PATH_LOCATION_VERIFICATION=/location-verification/v1/verify
NAC_PATH_LOCATION_RETRIEVAL=/location-retrieval/v0/retrieve
NAC_PATH_DEVICE_STATUS=/device-status/v0/connectivity
NAC_PATH_DEVICE_ROAMING=/device-status/device-roaming-status/v1/retrieve
NAC_PATH_DEVICE_REACHABILITY=/device-status/device-reachability-status/v1/retrieve

# How the agent treats what comes back.
# DEFAULT_MAX_AGE_SECONDS       how old a network observation may be and still count
# CONTEMPORANEITY_WINDOW_SECONDS  how close to the claimed time a device signal must
#                               sit before it is allowed to *conflict* with the claim
NAC_MAX_RETRIES=1
DEFAULT_MAX_AGE_SECONDS=900
CONTEMPORANEITY_WINDOW_SECONDS=1800
LLM_TIMEOUT=20

# ─── Demo geography ───────────────────────────────────────────────
# These drive the three demo outcomes, calibrated against the position the
# Nokia simulator actually reports (observed live, not taken from the guide).
# Site A sits on it so WO-1042 verifies on one call; Site B is ~940 km away so
# WO-1043 conflicts and forces an escalation; Site C is Casablanca with an
# unmapped device, so no evidence is obtainable at all.
# Left commented on purpose. Copying this file used to pin the coordinates
# into .env, so a later correction to the seeder's defaults had no effect and
# the demo silently kept the old geography. Uncomment only to demo elsewhere.
#SP_DEMO_SITE_A_LAT=50.735851
#SP_DEMO_SITE_A_LNG=7.10066
#SP_DEMO_SITE_B_LAT=47.48627616952785
#SP_DEMO_SITE_B_LNG=19.07915612501993
#SP_DEMO_SITE_C_LAT=33.5731
#SP_DEMO_SITE_C_LNG=-7.5898
