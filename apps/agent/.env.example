SP_ENV=local
AGENT_INTERNAL_TOKEN=dev-internal-token

# heuristic | gemini | groq | ollama
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT=20
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# auto | live | demo
CAMARA_MODE=auto
NAC_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
NAC_RAPIDAPI_KEY=
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_TIMEOUT=8
NAC_MAX_RETRIES=1

# Capability paths, confirmed against the Nokia developer portal. Each API
# carries its own CAMARA version and they do not move in step, so these stay
# configurable rather than hardcoded. A wrong path degrades to UNAVAILABLE
# evidence — safe, but you get no live data.
# Roaming also exists on the older Device Status operation: /device-status/v0/roaming
NAC_PATH_LOCATION_VERIFICATION=/location-verification/v1/verify
NAC_PATH_LOCATION_RETRIEVAL=/location-retrieval/v0/retrieve
NAC_PATH_DEVICE_STATUS=/device-status/v0/connectivity
NAC_PATH_DEVICE_ROAMING=/device-status/device-roaming-status/v1/retrieve
NAC_PATH_DEVICE_REACHABILITY=/device-status/device-reachability-status/v1/retrieve

# How the agent reads what comes back.
DEFAULT_MAX_AGE_SECONDS=900
CONTEMPORANEITY_WINDOW_SECONDS=1800

# Optional: lets the agent stream trace events back during a long run.
# The main flow does not need it — the whole trace returns with the response.
LARAVEL_BASE_URL=http://api:8000
